# DuoplesOS Versioning - Android 17
DUOPLES_VERSION_MAJOR = 2
DUOPLES_VERSION_MINOR = 0
DUOPLES_VERSION := 2.0
DUOPLES_BUILDTYPE = UNOFFICIAL
DUOPLES_ANDROID_VERSION = 17

# Date code
DUOPLES_DATE := $(shell date +%Y%m%d)
DUOPLES_BUILD_VERSION := $(DUOPLES_VERSION)-$(DUOPLES_DATE)-$(DUOPLES_BUILDTYPE)

# Display name for Android 17 ROM
PRODUCT_DISPLAY_NAME := DuoplesOS 2.0 (Android 17)
