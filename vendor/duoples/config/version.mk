# Duoplesos Versioning

DUOPLES_VERSION_MAJOR = 1
DUOPLES_VERSION_MINOR = 0
DUOPLES_VERSION := $(DUOPLES_VERSION_MAJOR).$(DUOPLES_VERSION_MINOR)
DUOPLES_BUILDTYPE = UNOFFICIAL

# Get the date
DUOPLES_DATE := $(shell date +%Y%m%d)

# Set the final version string
DUOPLES_BUILD_VERSION := $(DUOPLES_VERSION_MAJOR).$(DUOPLES_VERSION_MINOR)-$(DUOPLES_DATE)-$(DUOPLES_BUILDTYPE)

# Display name for the ROM
PRODUCT_DISPLAY_NAME := Duoplesos $(DUOPLES_BUILD_VERSION)
